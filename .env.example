# ---------------------------------------------------------------------------
# Startup-only settings
# ---------------------------------------------------------------------------
# These three values are read once when the process starts. Everything else in
# this file is only a fallback: the same option can be changed at runtime from
# the web UI (System Settings) and is stored in SQLite.

# Backend: bind to localhost unless you add authentication and TLS.
ADDR=127.0.0.1:8080
DATABASE_PATH=./data/pennyharvester.db

# Optional: serve frontend/dist from Gin after building the frontend.
# WEB_DIR=../frontend/dist

# ---------------------------------------------------------------------------
# Runtime settings (optional fallbacks)
# ---------------------------------------------------------------------------
# Prefer the web UI for normal changes: it applies without a restart and does
# not require editing this file. A non-empty value saved in the web UI overrides
# the corresponding environment variable. An empty web value inherits the
# environment value below, or the built-in public default.
#
# Secrets saved from the web UI are encrypted with AES-256-GCM in SQLite. The
# key is kept next to the database as "<DATABASE_PATH>.key" (0600). Back up the
# database and that key file together; without the key the stored credentials
# cannot be decrypted.

# Public market data endpoint (web UI: System Settings -> 行情与交易接口).
# GAMMA_BASE_URL=https://gamma-api.polymarket.com

# --- Live trading (real money) ---
# The default account is LIVE. Without a private key the live account refuses
# every order; it never falls back to the paper account silently.
# Use a dedicated small wallet. Never commit real keys.
# POLYMARKET_PRIVATE_KEY=0x...
# POLYMARKET_SIGNATURE_TYPE=0            # 0=EOA, 1=Proxy, 2=Safe, 3=Deposit/Poly1271
# POLYMARKET_FUNDER=0x...                # required for non-EOA; MUST be empty for EOA
# POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Optional: reuse existing CLOB L2 credentials instead of deriving them.
# Set all three values together, or leave all three empty (recommended: the
# executor derives them from the private key on first use).
# NOTE: the "Relayer API Key" (a UUID + address) created under
# polymarket.com Settings -> API Keys is a different credential for gasless
# relayed transactions. It cannot authenticate CLOB orders; never paste it here.
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# Live orders are signed and persisted as pending before submission. Unknown
# results are reconciled against the CLOB on later scans; an account with
# unresolved live orders skips automatic trading until reconciliation finishes.
# Taker fees are read from the market FeeSchedule and included in position cost.

# --- Outbound network (optional) ---
# The default proxy mode follows these variables. To switch modes without a
# restart, use the System Settings page in the web UI: the choice is stored in
# SQLite and applied to both Gamma and CLOB requests immediately.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost

# Web access password is NOT configured here. Set, change or disable it in the
# web UI (System Settings); only a bcrypt hash is stored in the database.
