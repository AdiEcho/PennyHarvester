# Backend: bind to localhost unless you add authentication and TLS.
ADDR=127.0.0.1:8080
DATABASE_PATH=./data/pennyharvester.db
GAMMA_BASE_URL=https://gamma-api.polymarket.com

# Optional: serve frontend/dist from Gin after building the frontend.
# WEB_DIR=../frontend/dist

# --- Live trading (real money) ---
# The default account is LIVE. Without a private key the live account refuses
# every order; it never falls back to the paper account silently.
# Use a dedicated small wallet. Never commit real keys.
# POLYMARKET_PRIVATE_KEY=0x...
# POLYMARKET_SIGNATURE_TYPE=0            # 0=EOA, 1=Proxy, 2=Safe, 3=Deposit/Poly1271
# POLYMARKET_FUNDER=0x...                # required for non-EOA signature types
# POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Optional: reuse existing CLOB L2 credentials instead of deriving them.
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
